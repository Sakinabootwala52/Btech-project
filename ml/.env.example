YOLO_MODEL_PATH=yolov8n.pt
YOLO_TRACKER=bytetrack.yaml
DETECTION_CONF=0.25

ACCIDENT_THRESHOLD=0.75
BUFFER_SECONDS=10
CLIP_SECONDS=5

SUDDEN_SPEED_DROP_RATIO=0.55
DIRECTION_CHANGE_DEGREES=55
MIN_ABNORMAL_FRAMES=8
MIN_TRACK_HISTORY=6
MIN_STOP_SPEED_RATIO=0.20
COLLISION_IOU_THRESHOLD=0.15

LOW_SEVERITY_SCORE=0.35
MEDIUM_SEVERITY_SCORE=0.60

OUTPUT_DIR=outputs

BACKEND_URL=http://localhost:5000
POST_TO_BACKEND=false
